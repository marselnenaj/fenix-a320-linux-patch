+/* Preserve the loader's NT path for an image supplied through an inherited fd.
+ * This assigns metadata only; the anonymous Unix file is not renamed. */
+int set_anonymous_fd_nt_name( struct fd *fd, struct unicode_str name )
+{
+    assert( !fd->nt_name );
+    if (!name.len) return 1;
+    if (!(fd->nt_name = memdup( name.str, name.len ))) return 0;
+    fd->nt_namelen = name.len;
+    return 1;
+}
