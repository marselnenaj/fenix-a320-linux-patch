+/* Enable after the PE exception dispatcher is available. */
+void virtual_enable_writecopy_tracking( void )
+{
+    const char *env = getenv( "WINE_TRACK_WRITECOPY" );
+    const WCHAR *image, *name;
+    const char *entry, *end;
+    unsigned int i, len;
+
+    track_writecopy = env && atoi( env );
+    if (!env || strncmp( env, "apps:", 5 )) return;
+    if (!NtCurrentTeb()->Peb->ProcessParameters) return;
+    image = NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer;
+    if (!image) return;
+    name = wcsrchr( image, '\\' );
+    name = name ? name + 1 : image;
+    len = wcslen( name );
+    for (entry = env + 5; *entry; entry = *end ? end + 1 : end)
+    {
+        end = strchr( entry, ',' );
+        if (!end) end = entry + strlen( entry );
+        if (end - entry != len) continue;
+        for (i = 0; i < len; i++)
+        {
+            unsigned int a = (unsigned char)entry[i], b = name[i];
+            if (a >= 'A' && a <= 'Z') a += 'a' - 'A';
+            if (b >= 'A' && b <= 'Z') b += 'a' - 'A';
+            if (a != b) break;
+        }
+        if (i == len)
+        {
+            track_writecopy = TRUE;
+            return;
+        }
+    }
+}
