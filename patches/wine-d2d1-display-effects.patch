+++ b/dlls/d2d1/display-layers.c.inc
@@ -0,0 +1,154 @@
+/* Offscreen layers for the scoped display renderer. Each layer retains its
+ * original target, mask and push-time transform until compositing on PopLayer. */
+struct d2d_display_layer
+{
+    struct d2d_display_layer *previous;
+    ID2D1Image *target;
+    struct d2d_bitmap *bitmap;
+    ID2D1Geometry *mask;
+    ID2D1Brush *opacity_brush;
+    D2D1_MATRIX_3X2_F transform, mask_transform;
+    D2D1_RECT_F bounds;
+    D2D1_ANTIALIAS_MODE antialias;
+    float opacity;
+    size_t clip_count;
+};
+
+static void d2d_display_layer_free(struct d2d_display_layer *layer)
+{
+    if (layer->target) ID2D1Image_Release(layer->target);
+    if (layer->bitmap) ID2D1Bitmap1_Release(&layer->bitmap->ID2D1Bitmap1_iface);
+    if (layer->mask) ID2D1Geometry_Release(layer->mask);
+    if (layer->opacity_brush) ID2D1Brush_Release(layer->opacity_brush);
+    free(layer);
+}
+
+static void d2d_display_layer_cleanup(struct d2d_device_context *context)
+{
+    struct d2d_display_layer *layer;
+    while ((layer = context->display_layers))
+    {
+        context->display_layers = layer->previous;
+        d2d_display_layer_free(layer);
+    }
+}
+
+static HRESULT d2d_display_layer_push(struct d2d_device_context *context, const D2D1_LAYER_PARAMETERS1 *params)
+{
+    ID2D1DeviceContext6 *iface = &context->ID2D1DeviceContext6_iface;
+    struct d2d_display_layer *layer;
+    D2D1_BITMAP_PROPERTIES1 properties = {0};
+    ID3D11DeviceContext1 *gpu;
+    const float transparent[4] = {0};
+    HRESULT hr;
+
+    if (context->target.type != D2D_TARGET_BITMAP) return D2DERR_WRONG_STATE;
+    if (params->layerOptions & ~(D2D1_LAYER_OPTIONS1_INITIALIZE_FROM_BACKGROUND | D2D1_LAYER_OPTIONS1_IGNORE_ALPHA))
+        return E_INVALIDARG;
+    if (!(layer = calloc(1, sizeof(*layer)))) return E_OUTOFMEMORY;
+    properties.pixelFormat = context->desc.pixelFormat;
+    properties.pixelFormat.alphaMode = (params->layerOptions & D2D1_LAYER_OPTIONS1_IGNORE_ALPHA)
+            ? D2D1_ALPHA_MODE_IGNORE : D2D1_ALPHA_MODE_PREMULTIPLIED;
+    properties.dpiX = context->desc.dpiX; properties.dpiY = context->desc.dpiY;
+    properties.bitmapOptions = D2D1_BITMAP_OPTIONS_TARGET;
+    if (FAILED(hr = d2d_bitmap_create(context, context->pixel_size, NULL, 0, &properties, &layer->bitmap)))
+    { free(layer); return hr; }
+    ID2D1DeviceContext6_GetTarget(iface, &layer->target);
+    layer->transform = context->drawing_state.transform;
+    layer->mask_transform = params->maskTransform;
+    layer->bounds = params->contentBounds;
+    layer->antialias = params->maskAntialiasMode;
+    layer->opacity = params->opacity;
+    layer->clip_count = context->clip_stack.count;
+    if ((layer->mask = params->geometricMask)) ID2D1Geometry_AddRef(layer->mask);
+    if ((layer->opacity_brush = params->opacityBrush)) ID2D1Brush_AddRef(layer->opacity_brush);
+    if (context->cs) EnterCriticalSection(context->cs);
+    ID3D11Device1_GetImmediateContext1(context->d3d_device, &gpu);
+    if (params->layerOptions & D2D1_LAYER_OPTIONS1_INITIALIZE_FROM_BACKGROUND)
+        ID3D11DeviceContext1_CopyResource(gpu, layer->bitmap->resource, context->target.bitmap->resource);
+    else
+        ID3D11DeviceContext1_ClearRenderTargetView(gpu, layer->bitmap->rtv, transparent);
+    ID3D11DeviceContext1_Release(gpu);
+    if (context->cs) LeaveCriticalSection(context->cs);
+    ID2D1DeviceContext6_SetTarget(iface, (ID2D1Image *)&layer->bitmap->ID2D1Bitmap1_iface);
+    layer->previous = context->display_layers;
+    context->display_layers = layer;
+    return S_OK;
+}
+
+static HRESULT d2d_display_layer_pop(struct d2d_device_context *context)
+{
+    ID2D1DeviceContext6 *iface = &context->ID2D1DeviceContext6_iface;
+    struct d2d_display_layer *layer = context->display_layers;
+    D2D1_DRAWING_STATE_DESCRIPTION1 state = context->drawing_state;
+    D2D1_BITMAP_BRUSH_PROPERTIES1 bitmap_properties = {D2D1_EXTEND_MODE_CLAMP, D2D1_EXTEND_MODE_CLAMP, D2D1_INTERPOLATION_MODE_LINEAR};
+    D2D1_BRUSH_PROPERTIES brush_properties = {1.0f, {{{1,0,0,1,0,0}}}};
+    ID2D1BitmapBrush1 *brush = NULL;
+    ID2D1Geometry *mask = NULL;
+    D2D1_MATRIX_3X2_F transform, opacity_transform;
+    D2D1_RECT_F bounds, full;
+    HRESULT hr;
+
+    if (!layer || context->clip_stack.count != layer->clip_count) return D2DERR_PUSH_POP_UNBALANCED;
+    context->display_layers = layer->previous;
+    ID2D1DeviceContext6_SetTarget(iface, layer->target);
+    full.left = full.top = 0;
+    full.right = context->pixel_size.width * 96.0f / context->desc.dpiX;
+    full.bottom = context->pixel_size.height * 96.0f / context->desc.dpiY;
+    brush_properties.opacity = layer->opacity;
+    hr = ID2D1DeviceContext6_CreateBitmapBrush(iface, (ID2D1Bitmap *)&layer->bitmap->ID2D1Bitmap1_iface,
+            &bitmap_properties, &brush_properties, &brush);
+    if (SUCCEEDED(hr))
+    {
+        if (layer->mask)
+        {
+            transform = layer->mask_transform;
+            d2d_matrix_multiply(&transform, &layer->transform);
+            hr = ID2D1Factory_CreateTransformedGeometry(context->factory, layer->mask, &transform,
+                    (ID2D1TransformedGeometry **)&mask);
+        }
+        else hr = ID2D1Factory_CreateRectangleGeometry(context->factory, &full, (ID2D1RectangleGeometry **)&mask);
+    }
+    if (SUCCEEDED(hr))
+    {
+        /* Transform bounds before clamping so InfiniteRect cannot overflow
+         * the integer scissor rectangle used by Wine's drawing backend. */
+        bounds = layer->bounds;
+        if (bounds.left <= -1e20f && bounds.top <= -1e20f && bounds.right >= 1e20f && bounds.bottom >= 1e20f)
+            bounds = full;
+        else
+        {
+            D2D1_POINT_2F points[4] = {{bounds.left, bounds.top}, {bounds.right, bounds.top},
+                    {bounds.left, bounds.bottom}, {bounds.right, bounds.bottom}};
+            unsigned int i;
+            for (i = 0; i < 4; ++i) d2d_point_transform(&points[i], &layer->transform, points[i].x, points[i].y);
+            bounds.left = bounds.right = points[0].x; bounds.top = bounds.bottom = points[0].y;
+            for (i = 1; i < 4; ++i)
+            {
+                bounds.left = fminf(bounds.left, points[i].x); bounds.right = fmaxf(bounds.right, points[i].x);
+                bounds.top = fminf(bounds.top, points[i].y); bounds.bottom = fmaxf(bounds.bottom, points[i].y);
+            }
+        }
+        d2d_rect_intersect(&bounds, &full);
+        ID2D1DeviceContext6_SetTransform(iface, &identity);
+        ID2D1DeviceContext6_SetAntialiasMode(iface, layer->antialias);
+        ID2D1DeviceContext6_PushAxisAlignedClip(iface, &bounds, D2D1_ANTIALIAS_MODE_ALIASED);
+        if (context->cs) EnterCriticalSection(context->cs);
+        if (layer->opacity_brush)
+        {
+            ID2D1Brush_GetTransform(layer->opacity_brush, &opacity_transform);
+            transform = opacity_transform;
+            d2d_matrix_multiply(&transform, &layer->transform);
+            ID2D1Brush_SetTransform(layer->opacity_brush, &transform);
+        }
+        ID2D1DeviceContext6_FillGeometry(iface, mask, (ID2D1Brush *)brush, layer->opacity_brush);
+        if (layer->opacity_brush) ID2D1Brush_SetTransform(layer->opacity_brush, &opacity_transform);
+        if (context->cs) LeaveCriticalSection(context->cs);
+        ID2D1DeviceContext6_PopAxisAlignedClip(iface);
+        context->drawing_state = state;
+    }
+    if (mask) ID2D1Geometry_Release(mask);
+    if (brush) ID2D1BitmapBrush1_Release(brush);
+    d2d_display_layer_free(layer);
+    return hr;
+}
