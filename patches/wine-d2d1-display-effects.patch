+        b.point1.y = cy + sn * x1 + cs * y1;
+        b.point2.x = cx + cs * x2 - sn * y2;
+        b.point2.y = cy + sn * x2 + cs * y2;
+        b.point3.x = cx + cs * rx * c1 - sn * ry * s1;
+        b.point3.y = cy + sn * rx * c1 + cs * ry * s1;
+        if (i + 1 == count) b.point3 = arc->point;
+        if (!d2d_figure_add_beziers(figure, &b, 1)) return false;
+        angle = end;
+    }
