+/* Endpoint-to-centre conversion, followed by short cubic segments.  Keep the
+ * segments small because the current renderer approximates cubics by quadratics. */
+static bool d2d_figure_add_arc(struct d2d_figure *figure, const D2D1_ARC_SEGMENT *arc)
+{
+    const double pi = 3.14159265358979323846;
+    D2D1_POINT_2F start = figure->vertices[figure->vertex_count - 1];
+    double rx = fabs(arc->size.width), ry = fabs(arc->size.height);
+    double phi = arc->rotationAngle * pi / 180.0, cs = cos(phi), sn = sin(phi);
+    double dx = (start.x - arc->point.x) * 0.5, dy = (start.y - arc->point.y) * 0.5;
+    double xp = cs * dx + sn * dy, yp = -sn * dx + cs * dy;
+    double scale, factor, cxp, cyp, cx, cy, ux, uy, vx, vy, angle, sweep, step;
+    unsigned int count, i;
+
+    if (!rx || !ry || (start.x == arc->point.x && start.y == arc->point.y))
+        return d2d_figure_add_lines(figure, &arc->point, 1);
+
+    scale = xp * xp / (rx * rx) + yp * yp / (ry * ry);
+    if (scale > 1.0)
+    {
+        scale = sqrt(scale);
+        rx *= scale;
+        ry *= scale;
+    }
+    scale = xp * xp / (rx * rx) + yp * yp / (ry * ry);
+    factor = sqrt(fmax(0.0, (1.0 - scale) / scale));
+    if ((arc->arcSize == D2D1_ARC_SIZE_LARGE) == (arc->sweepDirection == D2D1_SWEEP_DIRECTION_CLOCKWISE))
+        factor = -factor;
+    cxp = factor * rx * yp / ry;
+    cyp = -factor * ry * xp / rx;
+    cx = cs * cxp - sn * cyp + (start.x + arc->point.x) * 0.5;
+    cy = sn * cxp + cs * cyp + (start.y + arc->point.y) * 0.5;
+    ux = (xp - cxp) / rx;
+    uy = (yp - cyp) / ry;
+    vx = (-xp - cxp) / rx;
+    vy = (-yp - cyp) / ry;
+    angle = atan2(uy, ux);
+    sweep = atan2(ux * vy - uy * vx, ux * vx + uy * vy);
+    if (arc->sweepDirection == D2D1_SWEEP_DIRECTION_CLOCKWISE && sweep < 0.0) sweep += 2.0 * pi;
+    if (arc->sweepDirection == D2D1_SWEEP_DIRECTION_COUNTER_CLOCKWISE && sweep > 0.0) sweep -= 2.0 * pi;
+    count = max(1, (unsigned int)ceil(fabs(sweep) / (pi / 8.0)));
