+    if (FAILED(ID2D1Image_QueryInterface(image, &IID_ID2D1Effect, (void **)&effect))) return E_NOTIMPL;
+    hr = E_NOTIMPL;
+    if (FAILED(ID2D1Effect_GetValue(effect, D2D1_PROPERTY_CLSID, D2D1_PROPERTY_TYPE_CLSID, (BYTE *)&clsid, sizeof(clsid)))
+            || !IsEqualGUID(&clsid, &CLSID_D2D1Scale)) goto done;
+    if (FAILED(ID2D1Effect_GetValue(effect, D2D1_SCALE_PROP_SCALE, D2D1_PROPERTY_TYPE_VECTOR2, (BYTE *)&scale, sizeof(scale)))
+            || FAILED(ID2D1Effect_GetValue(effect, D2D1_SCALE_PROP_CENTER_POINT, D2D1_PROPERTY_TYPE_VECTOR2, (BYTE *)&center, sizeof(center)))
+            || FAILED(ID2D1Effect_GetValue(effect, D2D1_SCALE_PROP_INTERPOLATION_MODE, D2D1_PROPERTY_TYPE_ENUM, (BYTE *)&interpolation, sizeof(interpolation)))
+            || FAILED(ID2D1Effect_GetValue(effect, D2D1_SCALE_PROP_BORDER_MODE, D2D1_PROPERTY_TYPE_ENUM, (BYTE *)&border, sizeof(border)))) goto done;
+    if (center.x || center.y || scale.x <= 0 || scale.y <= 0
+            || interpolation != D2D1_SCALE_INTERPOLATION_MODE_LINEAR || border != D2D1_BORDER_MODE_SOFT) goto done;
+    ID2D1Effect_GetInput(effect, 0, &input);
+    if (SUCCEEDED(hr = d2d_display_effect_input(input, out, depth + 1)))
+    { out->width *= scale.x; out->height *= scale.y; }
+done:
+    if (input) ID2D1Image_Release(input);
+    ID2D1Effect_Release(effect);
+    return hr;
+}
+
+static HRESULT d2d_display_effect_render(struct d2d_device_context *context, ID2D1Image *image, struct d2d_bitmap **result)
+{
+    struct display_effect_input inputs[2] = {{0}};
+    ID2D1Effect *effect = NULL;
+    ID2D1Image *input = NULL;
+    ID3D11DeviceContext1 *gpu;
+    ID3DDeviceContextState *previous;
+    ID3D11ShaderResourceView *views[2];
+    D2D1_BITMAP_PROPERTIES1 properties = {0};
+    D2D1_SIZE_U size;
+    D3D11_VIEWPORT viewport = {0};
+    float constants[8] = {0};
+    UINT32 mode;
+    CLSID clsid;
+    HRESULT hr = E_NOTIMPL;
+    unsigned int i;
+
+    *result = NULL;
+    if (FAILED(ID2D1Image_QueryInterface(image, &IID_ID2D1Effect, (void **)&effect))) return E_NOTIMPL;
+    if (FAILED(ID2D1Effect_GetValue(effect, D2D1_PROPERTY_CLSID, D2D1_PROPERTY_TYPE_CLSID, (BYTE *)&clsid, sizeof(clsid)))
+            || !IsEqualGUID(&clsid, &CLSID_D2D1Blend)
+            || FAILED(ID2D1Effect_GetValue(effect, D2D1_BLEND_PROP_MODE, D2D1_PROPERTY_TYPE_ENUM, (BYTE *)&mode, sizeof(mode)))
+            || mode != D2D1_BLEND_MODE_OVERLAY) goto done;
+    for (i = 0; i < 2; ++i)
+    {
+        ID2D1Effect_GetInput(effect, i, &input);
+        hr = d2d_display_effect_input(input, &inputs[i], 0);
+        if (input) ID2D1Image_Release(input);
+        if (FAILED(hr)) goto done;
+        constants[2*i] = inputs[i].width; constants[2*i+1] = inputs[i].height;
+        constants[4+i] = inputs[i].bitmap->format.alphaMode == D2D1_ALPHA_MODE_IGNORE;
+        views[i] = inputs[i].bitmap->srv;
+    }
+    hr = E_NOTIMPL;
+    if (!(constants[0] > 0 && constants[1] > 0 && constants[2] > 0 && constants[3] > 0)
+            || !isfinite(constants[0]) || !isfinite(constants[1]) || !isfinite(constants[2]) || !isfinite(constants[3])) goto done;
+    if (fmaxf(constants[0], constants[2]) > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION
+            || fmaxf(constants[1], constants[3]) > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION) goto done;
+    size.width = ceilf(fmaxf(constants[0], constants[2])); size.height = ceilf(fmaxf(constants[1], constants[3]));
+    if (FAILED(hr = d2d_display_effect_init_gpu(context))) goto done;
+    properties.pixelFormat.format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    properties.pixelFormat.alphaMode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+    properties.dpiX = properties.dpiY = 96.0f;
+    properties.bitmapOptions = D2D1_BITMAP_OPTIONS_TARGET;
+    if (FAILED(hr = d2d_bitmap_create(context, size, NULL, 0, &properties, result))) goto done;
+    viewport.Width = size.width; viewport.Height = size.height; viewport.MaxDepth = 1.0f;
+    if (context->cs) EnterCriticalSection(context->cs);
+    ID3D11Device1_GetImmediateContext1(context->d3d_device, &gpu);
+    ID3D11DeviceContext1_SwapDeviceContextState(gpu, context->d3d_state, &previous);
+    ID3D11DeviceContext1_UpdateSubresource(gpu, (ID3D11Resource *)context->display_effect_cb, 0, NULL, constants, 0, 0);
+    ID3D11DeviceContext1_OMSetRenderTargets(gpu, 1, &(*result)->rtv, NULL);
+    ID3D11DeviceContext1_OMSetBlendState(gpu, NULL, NULL, ~0u);
+    ID3D11DeviceContext1_OMSetDepthStencilState(gpu, NULL, 0);
+    ID3D11DeviceContext1_IASetInputLayout(gpu, NULL);
+    ID3D11DeviceContext1_IASetPrimitiveTopology(gpu, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    ID3D11DeviceContext1_VSSetShader(gpu, context->display_effect_vs, NULL, 0);
+    ID3D11DeviceContext1_GSSetShader(gpu, NULL, NULL, 0);
+    ID3D11DeviceContext1_PSSetShader(gpu, context->display_effect_ps, NULL, 0);
+    ID3D11DeviceContext1_PSSetConstantBuffers(gpu, 0, 1, &context->display_effect_cb);
+    ID3D11DeviceContext1_PSSetShaderResources(gpu, 0, 2, views);
+    ID3D11DeviceContext1_PSSetSamplers(gpu, 0, 1, &context->display_effect_sampler);
+    ID3D11DeviceContext1_RSSetState(gpu, context->display_effect_rs);
+    ID3D11DeviceContext1_RSSetViewports(gpu, 1, &viewport);
+    ID3D11DeviceContext1_Draw(gpu, 3, 0);
+    ID3D11DeviceContext1_SwapDeviceContextState(gpu, previous, NULL);
+    if (previous) ID3DDeviceContextState_Release(previous);
+    ID3D11DeviceContext1_Release(gpu);
+    if (context->cs) LeaveCriticalSection(context->cs);
+done:
+    for (i = 0; i < 2; ++i) if (inputs[i].iface) ID2D1Bitmap_Release(inputs[i].iface);
+    ID2D1Effect_Release(effect);
+    return hr;
+}
