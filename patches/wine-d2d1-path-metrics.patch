+
+/* Preserve native distance, endpoint and tangent semantics, including curved
+ * and transformed paths. The same opt-in process scope as CombineWithGeometry
+ * applies; applications without the provider retain the original E_NOTIMPL. */
+static HRESULT d2d_geometry_provider_compute_length(ID2D1Geometry *source,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance, float *length)
+{
+    ID2D1Geometry *copy;
+    HRESULT hr;
+
+    InitOnceExecuteOnce(&geometry_provider_once, d2d_geometry_provider_init, NULL, NULL);
+    if (!geometry_provider_factory) return E_NOTIMPL;
+    if (FAILED(hr = d2d_geometry_provider_copy(source, &copy))) return hr;
+    hr = ID2D1Geometry_ComputeLength(copy, transform, tolerance, length);
+    ID2D1Geometry_Release(copy);
+    return hr;
+}
+
+static HRESULT d2d_geometry_provider_compute_point(ID2D1Geometry *source, float length,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance, D2D1_POINT_2F *point, D2D1_POINT_2F *tangent)
+{
+    ID2D1Geometry *copy;
+    HRESULT hr;
+
+    InitOnceExecuteOnce(&geometry_provider_once, d2d_geometry_provider_init, NULL, NULL);
+    if (!geometry_provider_factory) return E_NOTIMPL;
+    if (FAILED(hr = d2d_geometry_provider_copy(source, &copy))) return hr;
+    hr = ID2D1Geometry_ComputePointAtLength(copy, length, transform, tolerance, point, tangent);
+    ID2D1Geometry_Release(copy);
     return hr;
 }
 
